POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

OAUTH42_CLIENT_ID=
OAUTH42_CLIENT_SECRET=
OAUTH42_REDIRECT_URI=
OAUTH42_FRONTEND_REDIRECT_URI=

# Generate with: openssl rand -base64 32
JWT_SECRET=

# Origin allowed to open the WebSocket connection
FRONTEND_ORIGIN=

ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# SMTP. Default: Mailpit (emails are captured, readable at http://localhost:8025).
# Never leave a variable empty: an empty value overrides the default and breaks sending.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@transcendence.local

# Real delivery through Gmail: replace the block above with this one (uncommented).
# MAIL_PASSWORD is an app password (myaccount.google.com/apppasswords, requires
# 2-Step Verification), not the account password.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.address@gmail.com
# MAIL_PASSWORD=xxxxxxxxxxxxxxxx
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=your.address@gmail.com
